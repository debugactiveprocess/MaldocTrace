#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

export DH_GOLANG_EXCLUDES := internal/cfbtest

%:
	dh $@ --builddirectory=_build --buildsystem=golang

override_dh_auto_build:
	dh_auto_build -- -ldflags "-X github.com/debugactiveprocess/MaldocTrace.Version=$(DEB_VERSION_UPSTREAM)"

override_dh_auto_test:
	DH_GOLANG_EXCLUDES= dh_auto_test

override_dh_auto_install:
	dh_auto_install -- --no-source
